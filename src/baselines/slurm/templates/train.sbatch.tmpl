#!/bin/bash
# Slurm training-job template for EqFSA baseline adapters on CityUHK Burgundy. 
# Slurm sbatch directives: https://slurm.schedmd.com/sbatch.html 
# Singularity exec/bind/--nv options: https://docs.sylabs.io/guides/3.7/user-guide/cli/singularity_exec.html

#SBATCH --job-name=$TPL_JOB_NAME
#SBATCH --partition=$TPL_PARTITION
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=$TPL_CPUS_PER_TASK
#SBATCH --gres=gpu:$TPL_GPUS
#SBATCH --mem=$TPL_MEM
#SBATCH --time=$TPL_TIME
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err

$TPL_EXTRA_SBATCH_DIRECTIVES
set -euo pipefail

IMAGE="$TPL_IMAGE_PATH"
WORKDIR="$TPL_WORKDIR"
DIGEST_SIDECAR="$TPL_DIGEST_SIDECAR"

if [[ ! -x /usr/bin/singularity ]]; then
    echo "ERROR: /usr/bin/singularity is unavailable on $(hostname)." >&2
    exit 1
fi
if [[ ! -r "$IMAGE" ]]; then
    echo "ERROR: Cannot read container: $IMAGE" >&2
    exit 1
fi

mkdir -p "$WORKDIR"
cd "$WORKDIR"
export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"

srun /usr/bin/singularity exec \
    --nv \
    --bind "$WORKDIR:/work" \
    --bind "$DIGEST_SIDECAR:/opt/image_digest.txt:ro" \
    --pwd /work \
    "$IMAGE" \
    python -m $TPL_ADAPTER_MODULE $TPL_ADAPTER_ARGS
