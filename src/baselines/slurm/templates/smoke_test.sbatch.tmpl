#!/bin/bash
# Lightweight Slurm sanity-check job template for EqFSA baseline containers on CityUHK Burgundy

#SBATCH --job-name=$TPL_JOB_NAME
#SBATCH --partition=$TPL_PARTITION
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=$TPL_CPUS_PER_TASK
#SBATCH --gres=gpu:$TPL_GPUS
#SBATCH --mem=$TPL_MEM
#SBATCH --time=$TPL_TIME
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err
$TPL_EXTRA_SBATCH_DIRECTIVES
set -euo pipefail

IMAGE="$TPL_IMAGE_PATH"
WORKDIR="$TPL_WORKDIR"
DIGEST_SIDECAR="$TPL_DIGEST_SIDECAR"

if [[ ! -x /usr/bin/singularity ]]; then
    echo "ERROR: /usr/bin/singularity is unavailable on $(hostname)." >&2
    exit 1
fi
if [[ ! -r "$IMAGE" ]]; then
    echo "ERROR: Cannot read container: $IMAGE" >&2
    exit 1
fi

mkdir -p "$WORKDIR"
cd "$WORKDIR"
export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"

srun /usr/bin/singularity exec \
    --nv \
    --bind "$WORKDIR:/work" \
    --bind "$DIGEST_SIDECAR:/opt/image_digest.txt:ro" \
    --pwd /work \
    "$IMAGE" \
    python3 -c "import torch; print('cuda_available=', torch.cuda.is_available()); import $TPL_ADAPTER_MODULE; print('$TPL_ADAPTER_MODULE import OK')"
