#!/bin/bash
# Slurm training-job template for EqFSA baseline adapters on CityUHK Burgundy. 
# Slurm sbatch directives: https://slurm.schedmd.com/sbatch.html 
# Singularity exec/bind/--nv options: https://docs.sylabs.io/guides/3.7/user-guide/cli/singularity_exec.html

#SBATCH --job-name=$TPL_JOB_NAME
#SBATCH --partition=$TPL_PARTITION
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=$TPL_CPUS_PER_TASK
#SBATCH --gres=gpu:$TPL_GPUS
#SBATCH --mem=$TPL_MEM
#SBATCH --time=$TPL_TIME
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err

$TPL_EXTRA_SBATCH_DIRECTIVES
set -euo pipefail

IMAGE="$TPL_IMAGE_PATH"
WORKDIR="$TPL_WORKDIR"
DIGEST_SIDECAR="$TPL_DIGEST_SIDECAR"

if [[ ! -x /usr/bin/singularity ]]; then
    echo "ERROR: /usr/bin/singularity is unavailable on $(hostname)." >&2
    exit 1
fi
if [[ ! -r "$IMAGE" ]]; then
    echo "ERROR: Cannot read container: $IMAGE" >&2
    exit 1
fi

mkdir -p "$WORKDIR"
cd "$WORKDIR"
export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"

# Chain-safe: when this job is one of several dependent copies (sbatch --dependency=afterany), a finished run exits at once and an
# interrupted one resumes from its newest checkpoint, so hitting the 5-day walltime cap needs no manual requeue.
if [[ -f "$WORKDIR/checkpoints/checkpoint_final.pt" ]]; then
    echo "run already complete: $WORKDIR/checkpoints/checkpoint_final.pt -- nothing to do."
    exit 0
fi
RESUME_ARG=""
LATEST_CKPT="$(ls -t "$WORKDIR"/checkpoints/checkpoint_*.pt 2>/dev/null | head -n 1 || true)"
if [[ -n "$LATEST_CKPT" ]]; then
    RESUME_ARG="--resume $LATEST_CKPT"
    echo "resuming from $LATEST_CKPT"
fi

# The repo checkout is bind-mounted at /repo (see TPL_EXTRA_BINDS) and put on PYTHONPATH; the image only carries the third-party libraries.
$TPL_EXTRA_ENV
srun /usr/bin/singularity exec \
    --nv \
    --bind "$WORKDIR:/work" \
    --bind "$DIGEST_SIDECAR:/opt/image_digest.txt:ro" \
    $TPL_EXTRA_BINDS \
    --pwd /work \
    "$IMAGE" \
    python -m $TPL_ADAPTER_MODULE $TPL_ADAPTER_ARGS $RESUME_ARG
